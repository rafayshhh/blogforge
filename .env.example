# ==============================================================================
# BlogForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# Never commit your actual .env file with secrets to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI generation, research, and review)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
# Recommended options:
# - gemini-3.7-flash (Default, high-speed, cost-efficient, reasoning capabilities)
# - gemini-3.1-pro-preview (Maximum reasoning quality for complex strategy)
GEMINI_MODEL=gemini-3.7-flash

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
