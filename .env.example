# ==============================================================================
# BlogForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# Never commit your actual .env file with secrets to version control.
# ==============================================================================

# Active AI Provider (gemini, anthropic, openai, cursor)
# Default: gemini
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini Configuration
# ------------------------------------------------------------------------------
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Candidate options: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-4-hydrogen, gemini-4-argon, gemini-4-carbon
GEMINI_MODEL=gemini-3.8-flash

# Thinking Level for Gemini 3.8 Flash and Gemini 4: low, medium, high (default: medium)
GEMINI_THINKING_LEVEL=medium

# ------------------------------------------------------------------------------
# 2. Anthropic Claude Configuration
# ------------------------------------------------------------------------------
# Obtain your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Candidate options: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 3. OpenAI ChatGPT Configuration
# ------------------------------------------------------------------------------
# Obtain your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Candidate options: gpt-4o, gpt-4o-mini, o1, o3-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 4. Cursor / Custom OpenAI-Compatible Endpoint Configuration
# ------------------------------------------------------------------------------
# Connect to Cursor proxies, OpenRouter, Ollama, LM Studio, or local models
CURSOR_BASE_URL=http://localhost:11434/v1
CURSOR_API_KEY=optional_proxy_key_here

# Candidate options: cursor-small, deepseek-chat, claude-3-5-sonnet, gpt-4o, meta-llama/llama-3.3-70b-instruct
CURSOR_MODEL=cursor-small

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
